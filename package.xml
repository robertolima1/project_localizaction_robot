<?xml version="1.0"?>
<package format="2">
  <name>projeto_agrobot_uwb</name>
  <version>0.2.0</version>
  <description>
    Robô agrícola simulado (Gazebo), derivado do TurtleBot3 burger, com
    localização por EKF (robot_localization) fundindo IMU + odometria de
    rodas, e teleoperação manual por teclado.
  </description>

  <maintainer email="robertolimacomp@gmail.com">roberto-lima</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>gazebo_ros</depend>
  <depend>robot_localization</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz</depend>
  <depend>turtlebot3_description</depend>
  <exec_depend>rosbag</exec_depend>

  <!-- Plugin de sensor UWB simulado (externo, não faz parte deste pacote —
       clonado em ~/catkin_ws/src/uwb_gazebosensorplugins e
       ~/catkin_ws/src/gtec_msgs a partir de github.com/AUVSL). Só ativa o
       sensor (ranging); não participa do EKF. -->
  <exec_depend>uwb_gazebosensorplugins</exec_depend>
  <exec_depend>gtec_msgs</exec_depend>

  <export>
    <gazebo_ros gazebo_media_path="${prefix}"/>
  </export>
</package>
