<?xml version="1.0"?>
<!-- Launch único: Gazebo + robot_state_publisher + localização
     (robot_localization, ekf_uwb ou trilateracao, ver arg localizacao) +
     RViz + teleop + gravação do percurso. -->
<launch>
  <arg name="mundo" default="$(find projeto_agrobot_uwb)/worlds/campo_agricola.world"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="teleop" default="true"/>
  <arg name="gravar" default="true"/>
  <arg name="localizacao" default="robot_localization"/>  <!-- robot_localization | ekf_uwb | trilateracao -->

  <!-- Ruído — parametrizado para variar entre rodadas de experimento sem
       editar arquivo nenhum (ver README "Parametrizando ruído para
       experimentos"). Padrões batem com o comportamento de antes de
       virarem parâmetro. -->
  <arg name="mu_rodas" default="0.1"/>              <!-- atrito das rodas (drift de odometria) -->
  <arg name="gaussian_noise_imu" default="0.01"/>    <!-- ruído da IMU (gyro+accel) -->
  <arg name="sigma_range_extra" default="0.0"/>      <!-- m, ruído extra no range UWB -->
  <arg name="sigma_angle_extra" default="0.0"/>      <!-- rad, ruído extra no angle UWB -->
  <arg name="n_ancoras" default="10"/>               <!-- qtde de âncoras UWB (+ plantas) — ver scripts/layout_ancoras.py -->

  <include file="$(find projeto_agrobot_uwb)/launch/gazebo.launch">
    <arg name="mundo" value="$(arg mundo)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="mu_rodas" value="$(arg mu_rodas)"/>
    <arg name="gaussian_noise_imu" value="$(arg gaussian_noise_imu)"/>
    <arg name="n_ancoras" value="$(arg n_ancoras)"/>
  </include>

  <include file="$(find projeto_agrobot_uwb)/launch/display.launch">
    <arg name="rviz" value="$(arg rviz)"/>
  </include>

  <include file="$(find projeto_agrobot_uwb)/launch/localizacao.launch">
    <arg name="metodo" value="$(arg localizacao)"/>
    <arg name="origem_x" value="$(arg x)"/>
    <arg name="origem_y" value="$(arg y)"/>
    <arg name="origem_yaw" value="$(arg yaw)"/>
    <arg name="sigma_range_extra" value="$(arg sigma_range_extra)"/>
    <arg name="sigma_angle_extra" value="$(arg sigma_angle_extra)"/>
    <arg name="n_ancoras" value="$(arg n_ancoras)"/>
  </include>

  <group if="$(arg teleop)">
    <include file="$(find projeto_agrobot_uwb)/launch/teleop.launch"/>
  </group>

  <!-- Grava o percurso automaticamente em bags/percurso_<timestamp>.bag, sem
       precisar lembrar do comando manual do README. Desative com
       gravar:=false se não quiser gerar o arquivo (ex.: teste rápido). -->
  <group if="$(arg gravar)">
    <node pkg="rosbag" type="record" name="rosbag_record_percurso"
          args="-o $(find projeto_agrobot_uwb)/bags/percurso /odom /imu /odometry/filtered /cmd_vel /gtec/toa/ranging /gazebo/model_states"
          output="screen"/>
  </group>
</launch>
