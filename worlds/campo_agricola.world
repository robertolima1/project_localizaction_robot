<?xml version="1.0"?>
<!--
  Mundo do campo agrícola em escala reduzida (seção 4.7 do prompt).
  Só primitivas inline (sol e chão) — nenhum <uri>model://...>, então o
  mundo abre em qualquer máquina limpa sem GAZEBO_MODEL_PATH extra.

  Plantas e âncoras UWB NÃO estão mais aqui: eram blocos <model> fixos
  (10 plantas + 10 âncoras), o que exigia editar este XML à mão pra mudar
  a quantidade de âncoras. Agora scripts/spawn_campo.py spawna os pares
  planta+âncora em runtime via serviço do Gazebo, a partir do parâmetro
  ~n_ancoras (ver launch/gazebo.launch e scripts/layout_ancoras.py, fonte
  única do layout — duas fileiras espaçadas 1.0 m, y=-0.5/y=+0.5, x
  espalhado uniformemente). Corredor de 1.0 m contra os 0.178 m de
  largura do burger: ~41 cm de folga de cada lado.
-->
<sdf version="1.6">
  <world name="campo_agricola">

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sol (equivalente inline ao model://sun) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Chão marrom (terra), plano inline -->
    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.36 0.25 0.16 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>
