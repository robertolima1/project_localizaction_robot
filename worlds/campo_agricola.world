<?xml version="1.0"?>
<!--
  Mundo do campo agrícola em escala reduzida (seção 4.7 do prompt).
  Só primitivas inline (sol, chão e cilindros) — nenhum <uri>model://...>,
  então o mundo abre em qualquer máquina limpa sem GAZEBO_MODEL_PATH extra.

  Duas fileiras espaçadas 1.0 m (y = -0.5 e y = +0.5), com 5 cilindros
  cada (raio 0.05 m, altura 0.30 m), espaçados 0.4 m ao longo de x.
  Corredor de 1.0 m contra os 0.178 m de largura do burger: ~41 cm de folga
  de cada lado.
-->
<sdf version="1.6">
  <world name="campo_agricola">

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sol (equivalente inline ao model://sun) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Chão marrom (terra), plano inline -->
    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.36 0.25 0.16 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Fileira 1: y = -0.5 -->
    <model name="planta_1_1">
      <static>true</static>
      <pose>-0.8 -0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_1_2">
      <static>true</static>
      <pose>-0.4 -0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_1_3">
      <static>true</static>
      <pose>0.0 -0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_1_4">
      <static>true</static>
      <pose>0.4 -0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_1_5">
      <static>true</static>
      <pose>0.8 -0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fileira 2: y = +0.5 -->
    <model name="planta_2_1">
      <static>true</static>
      <pose>-0.8 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_2_2">
      <static>true</static>
      <pose>-0.4 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_2_3">
      <static>true</static>
      <pose>0.0 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_2_4">
      <static>true</static>
      <pose>0.4 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="planta_2_5">
      <static>true</static>
      <pose>0.8 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.13 0.45 0.13 1</ambient><diffuse>0.13 0.45 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Âncoras UWB (plugin uwb_gazebosensorplugins/gtec_uwb_plugin, pacote
      externo clonado em ~/catkin_ws/src/uwb_gazebosensorplugins).
      O nome de cada âncora PRECISA começar com o anchor_prefix configurado
      no plugin da tag (ver agrobot.gazebo.xacro) — aqui "uwb_anchor" — e
      terminar em um número (uwb_anchor0, uwb_anchor1, ...), sem exigir
      sequência contígua nem começar em zero.

      Uma âncora por planta (10 no total): mesmo x/y de cada
      planta_1_1..5 (y=-0.5) e planta_2_1..5 (y=0.5), no topo de um poste de
      1.0 m — como se cada planta tivesse sua própria âncora acima dela.
      Isso dá bastante variação de LOS/NLOS conforme o robô passa entre as
      fileiras (cada âncora fica bloqueada pela própria planta logo abaixo
      dependendo do ângulo), que é o efeito que o plugin simula.
    -->
    <model name="uwb_anchor0">
      <static>true</static>
      <pose>-0.8 -0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor1">
      <static>true</static>
      <pose>-0.4 -0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor2">
      <static>true</static>
      <pose>0.0 -0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor3">
      <static>true</static>
      <pose>0.4 -0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor4">
      <static>true</static>
      <pose>0.8 -0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor5">
      <static>true</static>
      <pose>-0.8 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor6">
      <static>true</static>
      <pose>-0.4 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor7">
      <static>true</static>
      <pose>0.0 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor8">
      <static>true</static>
      <pose>0.4 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="uwb_anchor9">
      <static>true</static>
      <pose>0.8 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
